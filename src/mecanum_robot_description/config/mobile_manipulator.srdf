<?xml version="1.0" encoding="UTF-8"?>
<robot name="mobil_manipulator">
    <group name="arm">
        <chain base_link="arm_base_link" tip_link="gripper_base_link"/>
    </group>
    <group name="gripper">
        <joint name="left_finger_joint"/>
        <joint name="right_finger_joint"/>
    </group>
    <end_effector name="gripper_ee" parent_link="gripper_base_link" group="gripper" parent_group="arm"/>
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_footprint"/>

    <disable_collisions link1="base_link" link2="arm_base_link" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link" link2="link1_1" reason="Adjacent"/>
    <disable_collisions link1="link1_1" link2="link2_1" reason="Adjacent"/>
    <disable_collisions link1="link2_1" link2="link3_1" reason="Adjacent"/>
    <disable_collisions link1="link3_1" link2="link4_1" reason="Adjacent"/>
    <disable_collisions link1="link3_1" link2="link5_1" reason="Never"/>
    <disable_collisions link1="link4_1" link2="link5_1" reason="Adjacent"/>
    <disable_collisions link1="link4_1" link2="right_finger" reason="Never"/>
    <disable_collisions link1="link5_1" link2="right_finger" reason="Never"/>
    <disable_collisions link1="link5_1" link2="left_finger" reason="Never"/>
    <disable_collisions link1="gripper_base_link" link2="left_finger" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="right_finger" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="link3_1" reason="Never"/>
    <disable_collisions link1="gripper_base_link" link2="link5_1" reason="Adjacent"/>
    <disable_collisions link1="left_finger" link2="link5_1" reason="Never"/>
    <disable_collisions link1="left_finger" link2="link4_1" reason="Never"/>
    <disable_collisions link1="base_link" link2="wheel_fl" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="wheel_fr" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="wheel_rl" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="wheel_rr" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="lidar_link" reason="Adjacent"/>
</robot>
