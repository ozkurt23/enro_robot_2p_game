<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:gz="http://gazebosim.org/schema"
       name="mobil_manipulator">

  <!-- Normal Gazebo/LLM profili yalnız native Gazebo arayüzünü kullanır.
       Reaktör 180'e ait özel kamera ancak o eski launch açıkça isterse eklenir. -->
  <xacro:arg name="enable_game_camera" default="false"/>

  <!-- ================= MECANUM BODY ================= -->

  <xacro:property name="body_length" value="1.0"/>
  <xacro:property name="body_width"  value="0.7"/>
  <xacro:property name="body_height" value="0.3"/>
  <xacro:property name="wheel_radius" value="0.1625"/>
  <xacro:property name="wheel_width"  value="0.09"/>
  <xacro:property name="wheel_scale" value="0.01"/>

  <xacro:property name="wheel_offset_x" value="${body_length/2 - 0.10}"/>
  <xacro:property name="wheel_offset_y" value="${body_width/2 + wheel_width +0.1}"/>

  <!-- The industrial mobile base carries an arm at full extension.  The old
       20 kg placeholder let the chassis pitch visibly during a physical
       lift; 80 kg is representative ballast for this simulation scale while
       the MecanumDrive velocity controller remains unchanged. -->
  <xacro:property name="body_mass"  value="80.0"/>
  <xacro:property name="wheel_mass" value="1.0"/>
  <xacro:property name="body_z" value="${wheel_radius + body_height/2}"/>

  <!-- Gazebo Sim does not consistently resolve package:// URIs emitted by
       xacro.  Resolve the package now so the festival build always displays
       the real mecanum STL meshes, both from source and after installation. -->
  <xacro:property name="wheel_mesh_right" value="file://$(find mecanum_robot_description)/meshes/mecanum_wheel_right.stl"/>
  <xacro:property name="wheel_mesh_left" value="file://$(find mecanum_robot_description)/meshes/mecanum_wheel_left.stl"/>
<!-- ================= S ROBOT ARM V2 ENTEGRASYONU ================= -->
  
  <xacro:include filename="$(find robot_arm_description)/urdf/robot_arm.xacro"/>

  <joint name="chassis_to_arm_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/> 
    <origin xyz="0 0 ${body_z + (body_height/2)}" rpy="0 0 0"/>
  </joint>
  <!-- BASE -->
<link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 -0.5" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia 
        ixx="${(1.0/12.0) * body_mass * (body_width*body_width + body_height*body_height)}" 
        iyy="${(1.0/12.0) * body_mass * (body_length*body_length + body_height*body_height)}" 
        izz="${(1.0/12.0) * body_mass * (body_length*body_length + body_width*body_width)}" 
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="clean_white">
        <color rgba="0.88 0.90 0.92 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>


  <!-- ================= MECANUM WHEELS ================= -->

  <xacro:macro name="mecanum_wheel" params="name parent x y z mesh fdir_x fdir_y">
    
    <link name="${name}">
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${(wheel_mass/12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyy="${(wheel_mass/2.0) * wheel_radius*wheel_radius}"
          izz="${(wheel_mass/12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="${mesh}" scale="${wheel_scale} ${wheel_scale} ${wheel_scale}"/>
        </geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${name}">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>7.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_footprint">${fdir_x} ${fdir_y} 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <!-- FL ve RR: fdir1 = (1, -1, 0)  |  FR ve RL: fdir1 = (1, 1, 0) -->

  <xacro:mecanum_wheel name="wheel_fl" parent="base_link"
    x="${wheel_offset_x}" y="${wheel_offset_y}" z="${wheel_radius}"
    mesh="${wheel_mesh_left}" fdir_x="1" fdir_y="-1"/>

  <xacro:mecanum_wheel name="wheel_fr" parent="base_link"
    x="${wheel_offset_x}" y="-${wheel_offset_y}" z="${wheel_radius}"
    mesh="${wheel_mesh_right}" fdir_x="1" fdir_y="1"/>

  <xacro:mecanum_wheel name="wheel_rl" parent="base_link"
    x="-${wheel_offset_x}" y="${wheel_offset_y}" z="${wheel_radius}"
    mesh="${wheel_mesh_right}" fdir_x="1" fdir_y="1"/>

  <xacro:mecanum_wheel name="wheel_rr" parent="base_link"
    x="-${wheel_offset_x}" y="-${wheel_offset_y}" z="${wheel_radius}"
    mesh="${wheel_mesh_left}" fdir_x="1" fdir_y="-1"/>


  <!-- ================= LIDAR ================= -->
       
      
  <xacro:property name="lidar_z" value="${body_z + body_height/2 + 0.02}"/>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- X=0.45 (Aracın burnunda), Y=0.0 (Ortalanmış), Z=lidar_z (Aracın üstünde) -->
    <origin xyz="0.45 0.0 ${lidar_z}" rpy="0 0 0"/> 
  </joint>
  
  <link name="lidar_link">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <!-- Sensor-only link: hiding the old grey puck cleans the manipulator's
         working area without changing lidar data. -->
  </link>

  <xacro:if value="$(arg enable_game_camera)">
  <!-- ================= FESTIVAL 3D GAME CAMERA ================= -->

  <!-- The small nose camera remains part of the robot silhouette, but the
       festival game uses the shared chase camera below. -->
  <joint name="driver_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="driver_camera_link"/>
    <origin xyz="0.43 0 ${body_z + 0.47}" rpy="0 0 0"/>
  </joint>
  <link name="driver_camera_link">
    <!-- Sensor frame retained for compatibility; the obsolete black nose
         camera housing is not part of the shared-camera game silhouette. -->
  </link>

  <!-- Rear-right 30-degree third-person camera for both players. This keeps
       the arm profile legible while restoring depth cues from the chassis and
       a slightly elevated, very wide almost-fisheye room view. -->
  <joint name="arm_operator_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_operator_camera_link"/>
    <origin xyz="-2.68 -1.55 ${body_z + 1.65}" rpy="0 0.38 0.523599"/>
  </joint>
  <link name="arm_operator_camera_link"/>
  </xacro:if>

 
 
<!--
  <gazebo>
    <plugin filename="libgz-sim-velocity-control-system.so"
            name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
      <link_name>base_footprint</link_name>
    </plugin>
  </gazebo>
-->

<gazebo>
  <plugin filename="libgz-sim-mecanum-drive-system.so"
          name="gz::sim::systems::MecanumDrive">
    <front_left_joint>wheel_fl_joint</front_left_joint>
    <front_right_joint>wheel_fr_joint</front_right_joint>
    <back_left_joint>wheel_rl_joint</back_left_joint>
    <back_right_joint>wheel_rr_joint</back_right_joint>
    <wheel_separation>1.08</wheel_separation>
    <wheelbase>0.80</wheelbase>
    <wheel_radius>0.1625</wheel_radius>
    
    <topic>/cmd_vel</topic>
    
    <odom_publish_frequency>30</odom_publish_frequency>
    <frame_id>odom</frame_id>
    <child_frame_id>base_footprint</child_frame_id>
    <odom_topic>/odom</odom_topic>
    <tf_topic>/tf</tf_topic>
  </plugin>
</gazebo>

<!-- Pearl-white visual finish for the mobile platform.  This section changes
     rendering only; the chassis geometry, mass and collision stay untouched. -->
<gazebo reference="base_link">
  <visual>
    <material>
      <ambient>0.46 0.48 0.50 1</ambient>
      <diffuse>0.88 0.90 0.92 1</diffuse>
      <specular>0.72 0.75 0.78 1</specular>
      <pbr><metal><metalness>0.28</metalness><roughness>0.34</roughness></metal></pbr>
    </material>
  </visual>
  <!-- The legacy camera/game profile uses physical self-contact as its manual
       joint stop.  Native MoveIt must match the validated upstream model and
       keep self-collision disabled; its planning-scene chassis proxy provides
       the manipulation safety boundary instead. -->
  <xacro:if value="$(arg enable_game_camera)">
    <self_collide>true</self_collide>
  </xacro:if>
  <xacro:unless value="$(arg enable_game_camera)">
    <self_collide>false</self_collide>
  </xacro:unless>
</gazebo>

<!-- ROS 2 Control Gazebo Plugin genel-->
<!--
<gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find mecanum_robot_description)/config/arm_controllers.yaml</parameters>
    </plugin>
  </gazebo>
      
-->

<gazebo reference="lidar_link">
  <sensor name="lidar_sensor" type="gpu_lidar">
    <topic>/scan</topic>
    <update_rate>10</update_rate>
    <gz_frame_id>lidar_link</gz_frame_id> 
    <pose>0 0 0 0 0 0</pose>
    <visualize>false</visualize>
    <!-- Nav2 and SLAM consume this scan in the native Gazebo arena.  Gazebo's
         hidden sensor render target remains active without adding an RViz or
         Reactor camera window. -->
    <always_on>true</always_on>
    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1.0</resolution>
            <min_angle>-2.09</min_angle>
            <max_angle>2.09</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.15</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </ray>
  </sensor>
</gazebo>

<xacro:if value="$(arg enable_game_camera)">
<gazebo reference="arm_operator_camera_link">
  <sensor name="shared_game_camera_sensor" type="camera">
    <topic>/reactor_180/game_camera</topic>
    <update_rate>20</update_rate>
    <camera>
      <horizontal_fov>1.95</horizontal_fov>
      <image>
        <width>1600</width>
        <height>900</height>
        <format>R8G8B8</format>
        <anti_aliasing>4</anti_aliasing>
      </image>
      <clip><near>0.12</near><far>28.0</far></clip>
    </camera>
    <always_on>true</always_on>
    <visualize>false</visualize>
  </sensor>
</gazebo>
</xacro:if>

</robot>
