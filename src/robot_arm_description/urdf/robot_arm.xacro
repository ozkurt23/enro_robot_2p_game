<?xml version="1.0" ?>
<robot name="robot_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:arg name="use_ros2_control" default="true" />
<xacro:arg name="use_native_control" default="false" />
<xacro:arg name="enable_game_assets" default="false" />
<!-- Standalone grasp-cell only: pin the arm base to Gazebo's world exactly as
     the upstream repository does.  The mobile manipulator leaves this false
     and attaches arm_base_link to its chassis instead. -->
<xacro:arg name="standalone_arm" default="false" />
<!-- Mobile arena only: spawn directly on the deterministic table-clearing
     MoveIt branch. Standalone/upstream profiles retain their ready pose. -->
<xacro:arg name="mobile_case_initial" default="false" />
<xacro:include filename="$(find robot_arm_description)/urdf/materials.xacro" />
<xacro:include filename="$(find robot_arm_description)/urdf/robot_arm.ros2control" />
<xacro:include filename="$(find robot_arm_description)/urdf/robot_arm.gazebo" />
<xacro:if value="$(arg standalone_arm)">
  <link name="world"/>
  <joint name="world_to_arm_base" type="fixed">
    <parent link="world"/>
    <child link="arm_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</xacro:if>

<link name="arm_base_link">
  <inertial>
    <origin xyz="0.014712625665330324 0.1104030365171965 0.045126245432456004" rpy="0 0 0"/>
    <mass value="1.346391"/>
    <inertia ixx="0.015764883" iyy="0.019490568" izz="0.022143950" ixy="-0.000000000" iyz="-0.000000000" ixz="0.000497100"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_arm_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0.11 0.09" rpy="0 0 0"/>
    <geometry><cylinder radius="0.16" length="0.18"/></geometry>
  </collision>
</link>

<link name="shoulder_link_v2_1">
  <inertial>
    <origin xyz="-0.00035045456964973747 -0.013538062073570417 0.10281772471825718" rpy="0 0 0"/>
    <mass value="1.306891"/>
    <inertia ixx="0.016597600" iyy="0.019874750" izz="0.013551083" ixy="-0.000025850" iyz="0.002596482" ixz="0.000078850"/>
  </inertial>
  <visual>
    <origin xyz="0.0 -0.110403 -0.184597" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_arm_description)/meshes/shoulder_link_v2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.047 -0.035 0.135" rpy="0 0 0"/>
    <geometry><box size="0.22 0.20 0.24"/></geometry>
  </collision>
</link>

<link name="upper_arm_link_v2_1">
  <inertial>
    <origin xyz="0.0860771295035334 -0.19746164423610849 -1.0453582749314627e-05" rpy="0 0 0"/>
    <mass value="0.888269"/>
    <inertia ixx="0.030127082" iyy="0.005919182" izz="0.031455283" ixy="0.001406950" iyz="-0.000000968" ixz="0.000000918"/>
  </inertial>
  <visual>
    <origin xyz="0.095 -0.040403 -0.459597" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_arm_description)/meshes/upper_arm_link_v2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.020 -0.262 0" rpy="0 0 0"/>
    <geometry><box size="0.13 0.45 0.13"/></geometry>
  </collision>
</link>

<link name="elbow_link_v2_1">
  <inertial>
    <origin xyz="0.052902702338458216 -0.025659794753081833 -0.00021904281386853075" rpy="0 0 0"/>
    <mass value="0.119430"/>
    <inertia ixx="0.000407768" iyy="0.000297132" izz="0.000394317" ixy="0.000000367" iyz="-0.000000918" ixz="0.000000000"/>
  </inertial>
  <visual>
    <origin xyz="0.054 0.484597 -0.459597" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_arm_description)/meshes/elbow_link_v2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.026 -0.041 0" rpy="0 0 0"/>
    <geometry><box size="0.13 0.10 0.13"/></geometry>
  </collision>
</link>

<link name="lower_link_v2_1">
  <inertial>
    <origin xyz="3.585542470080057e-05 -0.14132389998535622 -4.115182214436963e-07" rpy="0 0 0"/>
    <mass value="0.230197"/>
    <inertia ixx="0.002054683" iyy="0.000702300" izz="0.002163800" ixy="-0.000011800" iyz="-0.000000018" ixz="-0.000000000"/>
  </inertial>
  <visual>
    <origin xyz="0.001 0.567597 -0.459597" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_arm_description)/meshes/lower_link_v2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.026 -0.145 0" rpy="0 0 0"/>
    <geometry><box size="0.11 0.24 0.11"/></geometry>
  </collision>
</link>

<link name="wrist_link_v1_1">
  <inertial>
    <origin xyz="0.05107201270944397 -0.011906080047413892 0.00027679513001566125" rpy="0 0 0"/>
    <mass value="0.056296"/>
    <inertia ixx="0.000073483" iyy="0.000101617" izz="0.000108383" ixy="0.000000100" iyz="0.000000150" ixz="-0.000000000"/>
  </inertial>
  <visual>
    <origin xyz="0.053 0.858597 -0.459597" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_arm_description)/meshes/wrist_link_v1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.025 -0.025 0" rpy="0 0 0"/>
    <geometry><box size="0.11 0.08 0.09"/></geometry>
  </collision>
</link>

<link name="gripper_link_v2_1">
  <inertial>
    <origin xyz="-0.0010660299218875268 -0.04308680250375296 0.0009958827106185675" rpy="0 0 0"/>
    <mass value="0.024621"/>
    <inertia ixx="0.000017783" iyy="0.000027882" izz="0.000033467" ixy="0.000000018" iyz="0.000000133" ixz="-0.000000000"/>
  </inertial>
  <visual>
    <origin xyz="0.0018 0.909535 -0.460781" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_arm_description)/meshes/gripper_link_v2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <!--
    Convex palm collision proxy. The exported concave STL reaches the slider
    joint plane and produces intermittent adjacent-link impulses in Bullet,
    forcing one jaw outwards during closure. This box covers the complete
    visible palm volume but ends 12.5 mm before the moving finger links.  Its
    lower face is shortened by 7 mm so Bullet's contact margin cannot touch
    the table while the visible fingers are centred on the cube.
  -->
  <collision>
    <origin xyz="0 -0.0375 0.0045" rpy="0 0 0"/>
    <geometry>
      <box size="0.100 0.075 0.045"/>
    </geometry>
  </collision>
</link>

<!--
  Planning / grasp TCP.
  The exported gripper link frame is at the gripper body, not between the
  fingertips.  Keeping this fixed frame at the cube centre removes the
  hand-written TCP offsets from pick-and-place planning.
-->
<link name="grasp_frame"/>
<joint name="gripper_to_grasp_frame" type="fixed">
  <parent link="gripper_link_v2_1"/>
  <child link="grasp_frame"/>
  <origin xyz="0 -0.124 0.005" rpy="0 0 0"/>
</joint>

<xacro:if value="$(arg enable_game_assets)">
<!--
  Festival-only carried-cell presentation.  The visual belongs to grasp_frame,
  so it can never lag behind or drift away from the real fingers.  A tiny
  visibility joint keeps it 1.5 metres below the hand until gameplay confirms
  a real aligned pickup; this is reliable even on renderers that ignore alpha.
-->
<link name="held_core_visual_link">
  <inertial>
    <mass value="0.01"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="0.00001" iyy="0.00001" izz="0.00001"
             ixy="0" ixz="0" iyz="0"/>
  </inertial>
  <visual name="held_energy_cell">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry><box size="0.05 0.12 0.07"/></geometry>
    <material name="held_core_blue">
      <color rgba="0.04 0.78 1.0 1.0"/>
    </material>
  </visual>
</link>
<!-- Position 0 hides the visual 1.5 metres below the gripper. Position 1.5
     brings it exactly into grasp_frame only after a confirmed pickup.  The
     upper stop deliberately leaves controller headroom beyond that target. -->
<joint name="held_core_visibility_joint" type="prismatic">
  <parent link="grasp_frame"/>
  <child link="held_core_visual_link"/>
  <origin xyz="0 0 -1.5" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit lower="0.0" upper="1.6" effort="4" velocity="20.0"/>
  <dynamics damping="0.1" friction="0.0"/>
</joint>
</xacro:if>

<link name="jaw_one_v1_1">
  <inertial>
    <origin xyz="-0.01527629607958246 -0.036016115673927374 0.008044608205367287" rpy="0 0 0"/>
    <mass value="0.008454"/>
    <inertia ixx="0.000007550" iyy="0.000001732" izz="0.000007283" ixy="0.000000018" iyz="-0.000000367" ixz="0.000000200"/>
  </inertial>
  <visual>
    <origin xyz="-0.0482 0.997104 -0.458817" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_arm_description)/meshes/jaw_one_v1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <!--
    Inner finger contact surface for Gazebo physics.
    Keep it collision-only, but align it with the grey STL inner face.  The
    The STL's global X bound belongs to the rear mounting feature, not the
    fingertip.  At the cube's actual Y/Z section the grey inner face is
    x=-0.026 m in this link.  Put the collision face exactly there; otherwise
    Gazebo carries the cube on an invisible surface while the rendered
    fingers remain open.  The box covers only the distal grey finger and is
    not an extra visual pad.
  -->
  <collision name="jaw_one_inner_contact_collision">
    <origin xyz="-0.023 -0.043 0.0065" rpy="0 0 0"/>
    <geometry><box size="0.006 0.070 0.042"/></geometry>
  </collision>
</link>

<link name="jaw_two_v1_1">
  <inertial>
    <origin xyz="0.015274559603405395 -0.03618933785615064 0.004635449770394873" rpy="0 0 0"/>
    <mass value="0.008454"/>
    <inertia ixx="0.000007550" iyy="0.000001867" izz="0.000007168" ixy="0.000000000" iyz="0.000000918" ixz="0.000000200"/>
  </inertial>
  <visual>
    <origin xyz="0.0518 0.997104 -0.458817" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_arm_description)/meshes/jaw_two_v1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision name="jaw_two_inner_contact_collision">
    <origin xyz="0.023 -0.043 0.0065" rpy="0 0 0"/>
    <geometry><box size="0.006 0.070 0.042"/></geometry>
  </collision>
</link>

<joint name="revolute_1" type="revolute">
  <origin xyz="0.0 0.110403 0.184597" rpy="0 0 0"/>
  <parent link="arm_base_link"/>
  <child link="shoulder_link_v2_1"/>
  <axis xyz="0.0 -0.0 1.0"/>
  <!-- Festival/native-control keeps its old chassis-safe stop.  The normal
       ROS 2 control / MoveIt path must retain the complete limits from
       S_Robot_Arm_V2_Moveit_PP (aedf560), otherwise the repository's
       verified Cartesian grasp waypoints have no IK solution. -->
  <xacro:if value="$(arg use_native_control)">
    <limit lower="1.45" upper="1.69" effort="100" velocity="1.2"/>
  </xacro:if>
  <xacro:unless value="$(arg use_native_control)">
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="3.0"/>
  </xacro:unless>
  <dynamics damping="0.5" friction="0.0"/>
</joint>

<xacro:if value="$(arg use_native_control)">
  <joint name="revolute_2" type="continuous">
    <origin xyz="-0.095 -0.07 0.275" rpy="0 0 0"/>
    <parent link="shoulder_link_v2_1"/>
    <child link="upper_arm_link_v2_1"/>
    <axis xyz="1.0 -0.0 0.0"/>
    <!-- Festival control is continuous: contact with the chassis, arm or
         floor is the physical motion stop. -->
    <limit effort="180" velocity="1.4"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <joint name="revolute_3" type="continuous">
    <origin xyz="0.041 -0.525 0.0" rpy="0 0 0"/>
    <parent link="upper_arm_link_v2_1"/>
    <child link="elbow_link_v2_1"/>
    <axis xyz="1.0 -0.0 0.0"/>
    <limit effort="100" velocity="1.4"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>
</xacro:if>

<xacro:unless value="$(arg use_native_control)">
  <!-- These definitions intentionally match the validated upstream MoveIt
       model.  They are bounded revolute joints, not the festival's continuous
       manual-control joints. -->
  <joint name="revolute_2" type="revolute">
    <origin xyz="-0.095 -0.07 0.275" rpy="0 0 0"/>
    <parent link="shoulder_link_v2_1"/>
    <child link="upper_arm_link_v2_1"/>
    <axis xyz="1.0 -0.0 0.0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="3.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <joint name="revolute_3" type="revolute">
    <origin xyz="0.041 -0.525 0.0" rpy="0 0 0"/>
    <parent link="upper_arm_link_v2_1"/>
    <child link="elbow_link_v2_1"/>
    <axis xyz="1.0 -0.0 0.0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="3.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>
</xacro:unless>

<joint name="revolute_4" type="revolute">
  <origin xyz="0.053 -0.083 0.0" rpy="0 0 0"/>
  <parent link="elbow_link_v2_1"/>
  <child link="lower_link_v2_1"/>
  <axis xyz="-0.0 -1.0 -0.0"/>
  <xacro:if value="$(arg use_native_control)">
    <limit lower="-0.25" upper="0.25" effort="40" velocity="1.0"/>
  </xacro:if>
  <xacro:unless value="$(arg use_native_control)">
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="3.0"/>
  </xacro:unless>
  <dynamics damping="0.5" friction="0.0"/>
</joint>

<joint name="revolute_5" type="revolute">
  <origin xyz="-0.052 -0.291 0.0" rpy="0 0 0"/>
  <parent link="lower_link_v2_1"/>
  <child link="wrist_link_v1_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <xacro:if value="$(arg use_native_control)">
    <limit lower="-2.12" upper="-0.70" effort="40" velocity="1.2"/>
  </xacro:if>
  <xacro:unless value="$(arg use_native_control)">
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="3.0"/>
  </xacro:unless>
  <dynamics damping="0.5" friction="0.0"/>
</joint>

<joint name="revolute_6" type="revolute">
  <origin xyz="0.0512 -0.050938 0.001184" rpy="0 0 0"/>
  <parent link="wrist_link_v1_1"/>
  <child link="gripper_link_v2_1"/>
  <axis xyz="0.0 -0.99973 0.023249"/>
  <xacro:if value="$(arg use_native_control)">
    <limit lower="-1.15" upper="1.15" effort="30" velocity="1.2"/>
  </xacro:if>
  <xacro:unless value="$(arg use_native_control)">
    <limit lower="-3.30" upper="3.30" effort="100" velocity="3.0"/>
  </xacro:unless>
  <dynamics damping="0.5" friction="0.0"/>
</joint>

<joint name="slider_7" type="prismatic">
  <origin xyz="0.05 -0.087569 -0.001964" rpy="0 0 0"/>
  <parent link="gripper_link_v2_1"/>
  <child link="jaw_one_v1_1"/>
  <axis xyz="1.0 0.0 -0.0"/>
  <!-- Positive X moves jaw one outwards. -->
  <limit lower="-0.001" upper="0.055" effort="100" velocity="0.08"/>
  <dynamics damping="2.0" friction="0.02"/>
</joint>

<joint name="slider_8" type="prismatic">
  <origin xyz="-0.05 -0.087569 -0.001964" rpy="0 0 0"/>
  <parent link="gripper_link_v2_1"/>
  <child link="jaw_two_v1_1"/>
  <axis xyz="1.0 0.0 -0.0"/>
  <!-- Negative X moves jaw two outwards. -->
  <limit lower="-0.055" upper="0.001" effort="100" velocity="0.08"/>
  <dynamics damping="2.0" friction="0.02"/>
</joint>

</robot>
